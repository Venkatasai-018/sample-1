      { "name": "bucket", "label": "S3 bucket name", "type": "textbox", "query": "", "current": { "text": "", "value": "" }, "hide": 0, "skipUrlSync": false },
      { "name": "filterid", "label": "S3 request-metrics filter", "type": "textbox", "query": "EntireBucket", "current": { "text": "EntireBucket", "value": "EntireBucket" }, "hide": 0, "skipUrlSync": false }
