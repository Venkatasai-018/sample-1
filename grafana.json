      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "cloudwatch", "uid": "${datasource}" }, "queryMode": "Metrics", "region": "us-east-1", "namespace": "AWS/CloudFront", "metricName": "4xxErrorRate", "dimensions": { "DistributionId": "$distribution", "Region": "Global" }, "statistic": "Average", "matchExact": true, "metricQueryType": 0, "metricEditorMode": 0 } ] },

