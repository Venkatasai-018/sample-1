      "targets": [ { "refId": "A", "datasource": { "type": "cloudwatch", "uid": "${datasource}" }, "queryMode": "Metrics", "region": "us-east-1", "namespace": "AWS/CloudFront", "metricName": "TotalErrorRate", "dimensions": { "DistributionId": "$distribution", "Region": "Global" }, "statistic": "Average", "matchExact": true, "metricQueryType": 0, "metricEditorMode": 0 } ] },

