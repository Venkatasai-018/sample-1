      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "cloudwatch", "uid": "${datasource}" }, "queryMode": "Metrics", "region": "us-east-1", "namespace": "AWS/CloudFront", "metricName": "Requests", "dimensions": { "DistributionId": "$distribution", "Region": "Global" }, "statistic": "Sum", "matchExact": true, "metricQueryType": 0, "metricEditorMode": 0 } ] },

